  file_change {
    absolute_path_uri: "file:///src/components/Header.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React from \"react\";\nimport { ShieldCheck, Cpu, Terminal, ArrowUpRight, CheckCircle2 } from \"lucide-react\";\n\ninterface HeaderProps {\n  activeTab: string;\n  setActiveTab: (tab: string) => void;\n  oracleStatus: {\n    status: string;\n    protocol: string;\n    hasGeminiKey: boolean;\n    oraclePubKey: string;\n  };\n}\n\nexport const Header: React.FC<HeaderProps> = ({\n  activeTab,\n  setActiveTab,\n  oracleStatus,\n}) => {\n  const tabs = [\n    { id: \"overview\", label: \"01 // OVERVIEW & MACRO\" },\n    { id: \"exchange\", label: \"02 // INVOICE EXCHANGE\" },\n    { id: \"oracle\", label: \"03 // GEMINI CREDIT ORACLE\" },\n    { id: \"tranches\", label: \"04 // TRANCHE VAULTS\" },\n    { id: \"buyer\", label: \"05 // BUYER ATTESTATION\" },\n    { id: \"compliance\", label: \"06 // TReDS & WEBHOOKS\" },\n    { id: \"contracts\", label: \"07 // ANCHOR RUST SPEC\" },\n  ];\n\n  return (\n    <header className=\"border-b border-[#E4E4E7] bg-white sticky top-0 z-40\">\n      {/* Top micro-bar for system status and telemetry */}\n      <div className=\"border-b border-[#E4E4E7] px-6 py-2 flex flex-wrap items-center justify-between text-[11px] font-mono tracking-wider text-[#52525B]\">\n        <div className=\"flex items-center gap-4\">\n          <span className=\"flex items-center gap-1.5 font-semibold text-[#0A0A0A]\">\n            <span className=\"h-2 w-2 rounded-full bg-[#059669] animate-pulse\"></span>\n            SOLANA MAINNET-READY // TOKEN-2022\n          </span>\n          <span className=\"hidden md:inline text-[#A1A1AA]\">|</span>\n          <span className=\"hidden md:inline\">SETTLEMENT ASSET: SPL eINR (1:1 INR PEGGED)</span>\n          <span className=\"hidden lg:inline text-[#A1A1AA]\">|</span>\n          <span className=\"hidden lg:inline\">ORACLE PUBKEY: {oracleStatus.oraclePubKey.slice(0, 10)}...{oracleStatus.oraclePubKey.slice(-8)}</span>\n        </div>\n\n        <div className=\"flex items-center gap-3\">\n          <span className={`inline-flex items-center gap-1 px-2 py-0.5 text-[10px] font-mono uppercase tracking-widest ${\n            oracleStatus.hasGeminiKey ? \"bg-[#ECFDF5] text-[#059669] border border-[#A7F3D0]\" : \"bg-[#EFF6FF] text-[#2563EB] border border-[#BFDBFE]\"\n          }`}>\n            <Cpu className=\"w-3 h-3\" />\n            {oracleStatus.hasGeminiKey ? \"GEMINI 3.8 FLASH ACTIVE\" : \"GEMINI HEURISTIC ENGINE\"}\n          </span>\n          <span className=\"text-[#A1A1AA]\">15-DAY GRACE DEFAULT TRIGGER: ON</span>\n        </div>\n      </div>\n\n      {/* Main Brand & Asymmetric Nav */}\n      <div className=\"px-6 py-4 flex flex-col md:flex-row md:items-center justify-between gap-4\">\n        <div className=\"flex items-baseline gap-3\">\n          <h1 className=\"text-2xl md:text-3xl font-extrabold tracking-tight text-[#0A0A0A] font-mono\">\n            CREDEXA\n          </h1>\n          <span className=\"text-xs uppercase font-mono tracking-widest px-2 py-0.5 bg-[#0A0A0A] text-white font-semibold\">\n            PROTOCOL V1.4\n          </span>\n          <p className=\"text-xs text-[#71717A] hidden xl:inline max-w-sm leading-tight pl-2 border-l border-[#E4E4E7]\">\n            Decentralized MSME Invoice Discounting & Multi-Tranche Liquidity on Solana\n          </p>\n        </div>\n\n        {/* Global Key Metric Quick Ticker */}\n        <div className=\"flex items-center gap-6 text-xs font-mono\">\n          <div className=\"hidden sm:block text-right\">\n            <div className=\"text-[10px] text-[#71717A] tracking-wider uppercase\">TVL (eINR)</div>\n            <div className=\"font-bold text-[#0A0A0A]\">\342\202\27138,45,00,000</div>\n          </div>\n          <div className=\"hidden sm:block border-l border-[#E4E4E7] pl-4 text-right\">\n            <div className=\"text-[10px] text-[#71717A] tracking-wider uppercase\">INSURANCE RESERVE</div>\n            <div className=\"font-bold text-[#059669]\">\342\202\2711,48,50,000</div>\n          </div>\n          <div className=\"border-l border-[#E4E4E7] pl-4 text-right\">\n            <div className=\"text-[10px] text-[#71717A] tracking-wider uppercase\">MSME CASHFLOW LAG</div>\n            <div className=\"font-bold text-[#DC2626] line-through\">90\342\200\223120 Days</div>\n            <div className=\"font-bold text-[#059669]\">&lt;24h Tokenized</div>\n          </div>\n        </div>\n      </div>\n\n      {/* Swiss Asymmetric Tab Matrix */}\n      <div className=\"px-6 flex overflow-x-auto no-scrollbar border-t border-[#E4E4E7]\">\n        {tabs.map((tab) => {\n          const isActive = activeTab === tab.id;\n          return (\n            <button\n              key={tab.id}\n              onClick={() => setActiveTab(tab.id)}\n              className={`px-4 py-3 text-xs font-mono whitespace-nowrap tracking-wider font-semibold border-b-2 transition-all flex items-center gap-2 ${\n                isActive\n                  ? \"border-[#0A0A0A] text-[#0A0A0A] bg-[#F4F4F5]\"\n                  : \"border-transparent text-[#71717A] hover:text-[#0A0A0A] hover:bg-[#FAFAFA]\"\n              }`}\n            >\n              {tab.label}\n              {isActive && <span className=\"w-1.5 h-1.5 rounded-full bg-[#0A0A0A]\"></span>}\n            </button>\n          );\n        })}\n      </div>\n    </header>\n  );\n};\n"
    }
