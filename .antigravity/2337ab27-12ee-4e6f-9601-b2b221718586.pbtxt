  file_change {
    absolute_path_uri: "file:///src/App.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState, useEffect } from \"react\";\nimport { Header } from \"./components/Header\";\nimport { OverviewView } from \"./components/OverviewView\";\nimport { InvoiceExchangeView } from \"./components/InvoiceExchangeView\";\nimport { OracleInspectorView } from \"./components/OracleInspectorView\";\nimport { TrancheVaultsView } from \"./components/TrancheVaultsView\";\nimport { BuyerAttestationView } from \"./components/BuyerAttestationView\";\nimport { ComplianceWebhooksView } from \"./components/ComplianceWebhooksView\";\nimport { ContractSpecView } from \"./components/ContractSpecView\";\nimport { mockInvoices, mockTranchePools } from \"./data/mockInvoices\";\nimport { InvoiceRecord, OracleAuditResult, TranchePool } from \"./types\";\nimport { CheckCircle2, AlertCircle, Info, X } from \"lucide-react\";\n\ninterface ToastNotification {\n  id: string;\n  type: \"success\" | \"info\" | \"warning\";\n  title: string;\n  message: string;\n}\n\nexport default function App() {\n  const [activeTab, setActiveTab] = useState<string>(\"overview\");\n  const [invoices, setInvoices] = useState<InvoiceRecord[]>(mockInvoices);\n  const [pools, setPools] = useState<TranchePool[]>(mockTranchePools);\n  const [insuranceReserveBalance, setInsuranceReserveBalance] = useState<number>(14850000);\n  const [toasts, setToasts] = useState<ToastNotification[]>([]);\n  const [oracleStatus, setOracleStatus] = useState({\n    status: \"operational\",\n    protocol: \"Credexa Solana Credit Oracle\",\n    hasGeminiKey: false,\n    oraclePubKey: \"CRDx0rac1eEd25519PubKey...SPL2022\",\n  });\n\n  // Fetch live oracle status from backend\n  useEffect(() => {\n    fetch(\"/api/oracle/status\")\n      .then((res) => res.json())\n      .then((data) => {\n        setOracleStatus({\n          status: data.status || \"operational\",\n          protocol: data.protocol || \"Credexa Solana Credit Oracle\",\n          hasGeminiKey: !!data.hasGeminiKey,\n          oraclePubKey: data.oraclePubKey || \"CRDx0rac1eEd25519PubKey...SPL2022\",\n        });\n      })\n      .catch((err) => {\n        console.warn(\"Could not fetch oracle status from backend:\", err);\n      });\n  }, []);\n\n  const addToast = (type: \"success\" | \"info\" | \"warning\", title: string, message: string) => {\n    const id = Math.random().toString(36).slice(2, 9);\n    setToasts((prev) => [...prev, { id, type, title, message }]);\n    setTimeout(() => {\n      setToasts((prev) => prev.filter((t) => t.id !== id));\n    }, 6000);\n  };\n\n  const removeToast = (id: string) => {\n    setToasts((prev) => prev.filter((t) => t.id !== id));\n  };\n\n  // 1. Tokenize Invoice\n  const handleTokenize = (newInv: Partial<InvoiceRecord>) => {\n    const completeRecord = newInv as InvoiceRecord;\n    setInvoices((prev) => [completeRecord, ...prev]);\n    addToast(\n      \"success\",\n      \"INVOICE TOKENIZED // TOKEN-2022\",\n      `Created SPL Token-2022 digital asset for ${completeRecord.sellerName} (\342\202\271${(completeRecord.faceValueInr).toLocaleString(\"en-IN\")})`\n    );\n  };\n\n  // 2. Trigger Gemini Audit\n  const handleAuditInvoice = (invoice: InvoiceRecord) => {\n    setActiveTab(\"oracle\");\n  };\n\n  // 3. Complete Gemini Audit\n  const handleAuditComplete = (invoiceId: string, result: OracleAuditResult) => {\n    setInvoices((prev) =>\n      prev.map((inv) => {\n        if (inv.id === invoiceId) {\n          return {\n            ...inv,\n            status: \"Verified\",\n            authenticityScore: result.audit.authenticity_score,\n            riskTier: result.audit.default_risk_tier,\n            discountRateBps: result.audit.recommended_discount_rate_bps,\n            oracleSignature: result.oracleSignature,\n          };\n        }\n        return inv;\n      })\n    );\n\n    addToast(\n      \"success\",\n      \"GEMINI ORACLE VERIFICATION COMPLETED\",\n      `Invoice ${invoiceId} verified! Authenticity: ${result.audit.authenticity_score}/100, Tier: ${result.audit.default_risk_tier}, Ed25519 signed.`\n    );\n  };\n\n  // 4. Fund Invoice Tranches\n  const handleFundInvoice = (invoice: InvoiceRecord) => {\n    const seniorAmt = Math.round(invoice.fundedAmountInr * 0.8);\n    const juniorAmt = invoice.fundedAmountInr - seniorAmt;\n\n    setInvoices((prev) =>\n      prev.map((inv) => {\n        if (inv.id === invoice.id) {\n          return {\n            ...inv,\n            status: \"Funded\",\n            seniorFundingInr: seniorAmt,\n            juniorFundingInr: juniorAmt,\n          };\n        }\n        return inv;\n      })\n    );\n\n    // Update pool capacities\n    setPools((prev) =>\n      prev.map((p) => {\n        if (p.type === \"Senior\") {\n          return {\n            ...p,\n            availableCapacityInr: Math.max(0, p.availableCapacityInr - seniorAmt),\n            totalDepositedInr: p.totalDepositedInr + seniorAmt,\n          };\n        } else {\n          return {\n            ...p,\n            availableCapacityInr: Math.max(0, p.availableCapacityInr - juniorAmt),\n            totalDepositedInr: p.totalDepositedInr + juniorAmt,\n          };\n        }\n      })\n    );\n\n    addToast(\n      \"success\",\n      \"TRANCHES DISBURSED // eINR SETTLED\",\n      `Disbursed \342\202\271${invoice.fundedAmountInr.toLocaleString(\"en-IN\")} eINR to ${invoice.sellerName} (Senior: \342\202\271${seniorAmt.toLocaleString(\"en-IN\")}, Junior: \342\202\271${juniorAmt.toLocaleString(\"en-IN\")})`\n    );\n  };\n\n  // 5. Enterprise Buyer Attestation\n  const handleBuyerAttest = (invoice: InvoiceRecord) => {\n    setInvoices((prev) =>\n      prev.map((inv) => {\n        if (inv.id === invoice.id) {\n          return {\n            ...inv,\n            buyerAttested: true,\n            discountRateBps: Math.max(400, inv.discountRateBps - 200),\n            buyerRebateBps: 150,\n          };\n        }\n        return inv;\n      })\n    );\n\n    addToast(\n      \"success\",\n      \"BUYER ATTESTATION SIGNED\",\n      `Enterprise Buyer (${invoice.buyerName}) co-signed on-chain. Discount rate reduced by 200 bps; early rebate enabled.`\n    );\n  };\n\n  // 6. Settle Invoice (with Rebate)\n  const handleSettleInvoice = (invoice: InvoiceRecord, rebateAmount: number = 0) => {\n    setInvoices((prev) =>\n      prev.map((inv) => {\n        if (inv.id === invoice.id) {\n          return {\n            ...inv,\n            status: \"Settled\",\n          };\n        }\n        return inv;\n      })\n    );\n\n    // Protocol fee contribution to insurance reserve\n    const reserveFee = Math.round(invoice.faceValueInr * 0.002); // 20 bps protocol fee\n    setInsuranceReserveBalance((prev) => prev + reserveFee);\n\n    addToast(\n      \"info\",\n      \"INVOICE FULLY SETTLED\",\n      `Repayment received! ${rebateAmount > 0 ? `Deducted \342\202\271${rebateAmount.toLocaleString(\"en-IN\")} early payment rebate.` : \"\"} Senior principal + interest returned.`\n    );\n  };\n\n  // 7. Trigger Default (Grace Period Expired)\n  const handleTriggerDefault = (invoice: InvoiceRecord) => {\n    setInvoices((prev) =>\n      prev.map((inv) => {\n        if (inv.id === invoice.id) {\n          return {\n            ...inv,\n            status: \"Defaulted\",\n          };\n        }\n        return inv;\n      })\n    );\n\n    if (invoice.factoringMode === \"Recourse\") {\n      addToast(\n        \"warning\",\n        \"RECOURSE DEFAULT TRIGGERED\",\n        `Liquidated MSME locked collateral (\342\202\271${(invoice.collateralLockedInr || 0).toLocaleString(\"en-IN\")}) to reimburse Senior Tranche depositors.`\n      );\n    } else {\n      addToast(\n        \"warning\",\n        \"NON-RECOURSE DEFAULT TRIGGERED\",\n        `Default loss absorbed by Junior First-Loss Pool and Insurance Reserve PDA. Senior Tranche depositors protected.`\n      );\n    }\n  };\n\n  return (\n    <div className=\"min-h-screen bg-[#F4F4F5] text-[#0A0A0A] flex flex-col font-sans selection:bg-[#0A0A0A] selection:text-white\">\n      {/* Swiss Monospaced Header */}\n      <Header\n        activeTab={activeTab}\n        setActiveTab={setActiveTab}\n        oracleStatus={oracleStatus}\n      />\n\n      {/* Main Container */}\n      <main className=\"flex-1 max-w-7xl w-full mx-auto p-4 md:p-8 space-y-8\">\n        {activeTab === \"overview\" && (\n          <OverviewView invoices={invoices} onNavigate={setActiveTab} />\n        )}\n\n        {activeTab === \"exchange\" && (\n          <InvoiceExchangeView\n            invoices={invoices}\n            onTokenize={handleTokenize}\n            onAuditInvoice={handleAuditInvoice}\n            onFundInvoice={handleFundInvoice}\n            onBuyerAttest={handleBuyerAttest}\n            onSettleInvoice={handleSettleInvoice}\n            onTriggerDefault={handleTriggerDefault}\n          />\n        )}\n\n        {activeTab === \"oracle\" && (\n          <OracleInspectorView\n            invoices={invoices}\n            onAuditComplete={handleAuditComplete}\n          />\n        )}\n\n        {activeTab === \"tranches\" && (\n          <TrancheVaultsView\n            pools={pools}\n            insuranceReserveBalance={insuranceReserveBalance}\n          />\n        )}\n\n        {activeTab === \"buyer\" && (\n          <BuyerAttestationView\n            invoices={invoices}\n            onAttestInvoice={handleBuyerAttest}\n            onSettleWithRebate={handleSettleInvoice}\n          />\n        )}\n\n        {activeTab === \"compliance\" && (\n          <ComplianceWebhooksView invoices={invoices} />\n        )}\n\n        {activeTab === \"contracts\" && <ContractSpecView />}\n      </main>\n\n      {/* Swiss Minimalist Footer */}\n      <footer className=\"border-t border-[#E4E4E7] bg-white py-6 px-6 font-mono text-xs text-[#71717A]\">\n        <div className=\"max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-between gap-4\">\n          <div className=\"flex items-center gap-3\">\n            <span className=\"font-bold text-[#0A0A0A]\">CREDEXA // PROTOCOL</span>\n            <span>\342\200\242</span>\n            <span>SPL TOKEN-2022</span>\n            <span>\342\200\242</span>\n            <span>GEMINI MULTIMODAL CREDIT ORACLE</span>\n          </div>\n\n          <div className=\"flex items-center gap-4 text-[11px]\">\n            <span>ANCHOR ID: CRDxPr0t...111</span>\n            <span>eINR SETTLEMENT ONLY</span>\n            <span className=\"text-[#059669] font-semibold\">ALL CONTRACT TESTS PASSING</span>\n          </div>\n        </div>\n      </footer>\n\n      {/* Toast Notification Container */}\n      <div className=\"fixed bottom-6 right-6 z-50 space-y-2 max-w-md w-full font-mono text-xs pointer-events-none\">\n        {toasts.map((toast) => (\n          <div\n            key={toast.id}\n            className={`pointer-events-auto border-2 p-4 shadow-xl transition-all flex items-start justify-between gap-3 ${\n              toast.type === \"success\"\n                ? \"bg-[#0A0A0A] text-white border-[#059669]\"\n                : toast.type === \"warning\"\n                ? \"bg-[#0A0A0A] text-white border-[#DC2626]\"\n                : \"bg-[#0A0A0A] text-white border-[#2563EB]\"\n            }`}\n          >\n            <div className=\"space-y-1\">\n              <div className=\"font-bold tracking-wider flex items-center gap-1.5 text-[11px]\">\n                {toast.type === \"success\" && <CheckCircle2 className=\"w-3.5 h-3.5 text-[#059669]\" />}\n                {toast.type === \"warning\" && <AlertCircle className=\"w-3.5 h-3.5 text-[#DC2626]\" />}\n                {toast.type === \"info\" && <Info className=\"w-3.5 h-3.5 text-[#2563EB]\" />}\n                <span>{toast.title}</span>\n              </div>\n              <div className=\"text-[11px] text-[#D4D4D8] font-sans leading-relaxed\">{toast.message}</div>\n            </div>\n            <button\n              onClick={() => removeToast(toast.id)}\n              className=\"text-[#A1A1AA] hover:text-white\"\n            >\n              <X className=\"w-4 h-4\" />\n            </button>\n          </div>\n        ))}\n      </div>\n    </div>\n  );\n}\n"
    }
