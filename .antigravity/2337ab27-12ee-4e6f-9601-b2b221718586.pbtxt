  file_change {
    absolute_path_uri: "file:///src/components/TrancheVaultsView.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \"react\";\nimport {\n  Layers,\n  ShieldCheck,\n  Zap,\n  Coins,\n  ArrowRight,\n  TrendingUp,\n  Percent,\n  CheckCircle2,\n  Lock,\n  ArrowDownRight,\n} from \"lucide-react\";\nimport { TranchePool } from \"../types\";\n\ninterface TrancheVaultsViewProps {\n  pools: TranchePool[];\n  insuranceReserveBalance: number;\n}\n\nexport const TrancheVaultsView: React.FC<TrancheVaultsViewProps> = ({\n  pools,\n  insuranceReserveBalance,\n}) => {\n  const [selectedPoolId, setSelectedPoolId] = useState<string>(\"senior-pool-01\");\n  const [depositAmount, setDepositAmount] = useState<string>(\"500000\"); // 5 Lakhs\n  const [depositSuccessMsg, setDepositSuccessMsg] = useState<string | null>(null);\n\n  const activePool = pools.find((p) => p.id === selectedPoolId) || pools[0];\n  const numDeposit = Number(depositAmount) || 0;\n  const estimatedLpTokens = numDeposit > 0 ? (numDeposit / activePool.lpPriceInr).toFixed(2) : \"0.00\";\n  const estimatedAnnualYield = ((numDeposit * activePool.targetApy) / 100).toFixed(0);\n\n  const handleSimulateDeposit = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (numDeposit <= 0) return;\n    setDepositSuccessMsg(\n      `Successfully minted ${estimatedLpTokens} ${activePool.type === \"Senior\" ? \"CRDx-SnrLP\" : \"CRDx-JnrLP\"} tokens for \342\202\271${numDeposit.toLocaleString(\"en-IN\")} eINR deposit.`\n    );\n    setTimeout(() => setDepositSuccessMsg(null), 5000);\n  };\n\n  return (\n    <div className=\"space-y-8\">\n      {/* Top Banner */}\n      <div className=\"border border-[#0A0A0A] bg-white p-6 md:p-8\">\n        <div className=\"flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-[#E4E4E7] pb-4\">\n          <div>\n            <div className=\"text-xs font-mono uppercase text-[#71717A] tracking-wider flex items-center gap-2\">\n              <span className=\"w-2 h-2 rounded-full bg-[#059669]\"></span>\n              MULTI-TRANCHE CAPITAL WATERFALL // TOKENIZED SPL LP LIQUIDITY\n            </div>\n            <h2 className=\"text-2xl md:text-3xl font-extrabold tracking-tight text-[#0A0A0A] font-mono mt-1\">\n              Senior Protection &amp; Junior First-Loss Liquidity Pools\n            </h2>\n          </div>\n          <div className=\"text-right font-mono\">\n            <div className=\"text-[10px] text-[#71717A] uppercase\">PROTOCOL RESERVE PDA</div>\n            <div className=\"text-xl font-extrabold text-[#059669]\">\n              \342\202\271{(insuranceReserveBalance).toLocaleString(\"en-IN\")} eINR\n            </div>\n          </div>\n        </div>\n\n        <p className=\"text-xs text-[#52525B] max-w-3xl pt-3 leading-relaxed\">\n          Credexa segments risk into two distinct on-chain pools: Senior Tranches offer capital preservation for everyday depositors by having the Junior Tranche absorb the first 20% of any default. Liquidity providers receive transferable SPL LP tokens for secondary exit before invoice maturity.\n        </p>\n      </div>\n\n      {/* Side-by-Side Tranche Comparison (Asymmetric Swiss Grid) */}\n      <div className=\"grid grid-cols-1 md:grid-cols-2 gap-6 font-mono\">\n        {/* Senior Tranche Card */}\n        <div className=\"border-2 border-[#0A0A0A] bg-white p-6 space-y-4\">\n          <div className=\"flex items-center justify-between border-b border-[#E4E4E7] pb-3\">\n            <div className=\"flex items-center gap-2\">\n              <ShieldCheck className=\"w-5 h-5 text-[#2563EB]\" />\n              <span className=\"font-extrabold text-sm uppercase text-[#0A0A0A]\">\n                SENIOR CAPITAL PROTECTION TRANCHE\n              </span>\n            </div>\n            <span className=\"px-2 py-0.5 bg-[#EFF6FF] text-[#2563EB] text-[10px] font-bold border border-[#BFDBFE]\">\n              100% CAPITAL PROTECTED\n            </span>\n          </div>\n\n          <div className=\"grid grid-cols-2 gap-4\">\n            <div>\n              <div className=\"text-[10px] text-[#71717A] uppercase\">TARGET APY</div>\n              <div className=\"text-3xl font-extrabold text-[#2563EB]\">11.5%</div>\n              <div className=\"text-[10px] text-[#52525B]\">Net in eINR stablecoin</div>\n            </div>\n            <div>\n              <div className=\"text-[10px] text-[#71717A] uppercase\">TOTAL DEPOSITED</div>\n              <div className=\"text-xl font-bold text-[#0A0A0A]\">\342\202\27128.20 Crore</div>\n              <div className=\"text-[10px] text-[#059669]\">\342\202\2716.75 Cr Available</div>\n            </div>\n          </div>\n\n          <div className=\"text-xs text-[#52525B] font-sans leading-relaxed border-t border-[#E4E4E7] pt-3\">\n            Designed for institutional treasuries and retail liquidity providers. Senior principal and interest are paid first in the Anchor smart contract waterfall upon invoice settlement.\n          </div>\n\n          <div className=\"bg-[#F8F9FA] p-3 text-[11px] space-y-1 border border-[#E4E4E7]\">\n            <div className=\"flex justify-between\">\n              <span className=\"text-[#71717A]\">LP Token Mint:</span>\n              <span className=\"text-[#0A0A0A] font-bold\">CRDx-SnrLP (SPL)</span>\n            </div>\n            <div className=\"flex justify-between\">\n              <span className=\"text-[#71717A]\">LP Price:</span>\n              <span className=\"text-[#0A0A0A] font-bold\">\342\202\271108.42 eINR</span>\n            </div>\n            <div className=\"flex justify-between\">\n              <span className=\"text-[#71717A]\">First-Loss Buffer:</span>\n              <span className=\"text-[#059669] font-bold\">20% Absorbed by Junior</span>\n            </div>\n          </div>\n        </div>\n\n        {/* Junior Tranche Card */}\n        <div className=\"border-2 border-[#0A0A0A] bg-white p-6 space-y-4\">\n          <div className=\"flex items-center justify-between border-b border-[#E4E4E7] pb-3\">\n            <div className=\"flex items-center gap-2\">\n              <Zap className=\"w-5 h-5 text-[#D97706]\" />\n              <span className=\"font-extrabold text-sm uppercase text-[#0A0A0A]\">\n                JUNIOR FIRST-LOSS YIELD TRANCHE\n              </span>\n            </div>\n            <span className=\"px-2 py-0.5 bg-[#FFFBEB] text-[#D97706] text-[10px] font-bold border border-[#FDE68A]\">\n              FIRST-LOSS ABSORPTION\n            </span>\n          </div>\n\n          <div className=\"grid grid-cols-2 gap-4\">\n            <div>\n              <div className=\"text-[10px] text-[#71717A] uppercase\">TARGET APY</div>\n              <div className=\"text-3xl font-extrabold text-[#059669]\">24.0%</div>\n              <div className=\"text-[10px] text-[#52525B]\">High-yield underwriting</div>\n            </div>\n            <div>\n              <div className=\"text-[10px] text-[#71717A] uppercase\">TOTAL DEPOSITED</div>\n              <div className=\"text-xl font-bold text-[#0A0A0A]\">\342\202\27110.25 Crore</div>\n              <div className=\"text-[10px] text-[#059669]\">\342\202\2712.36 Cr Available</div>\n            </div>\n          </div>\n\n          <div className=\"text-xs text-[#52525B] font-sans leading-relaxed border-t border-[#E4E4E7] pt-3\">\n            Tailored for credit funds and specialized DeFi underwriters. Absorbs initial invoice defaults in exchange for superior annualized yields and protocol fee sharing.\n          </div>\n\n          <div className=\"bg-[#F8F9FA] p-3 text-[11px] space-y-1 border border-[#E4E4E7]\">\n            <div className=\"flex justify-between\">\n              <span className=\"text-[#71717A]\">LP Token Mint:</span>\n              <span className=\"text-[#0A0A0A] font-bold\">CRDx-JnrLP (SPL)</span>\n            </div>\n            <div className=\"flex justify-between\">\n              <span className=\"text-[#71717A]\">LP Price:</span>\n              <span className=\"text-[#0A0A0A] font-bold\">\342\202\271124.85 eINR</span>\n            </div>\n            <div className=\"flex justify-between\">\n              <span className=\"text-[#71717A]\">Risk Exposure:</span>\n              <span className=\"text-[#D97706] font-bold\">First 20% default exposure</span>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      {/* Interactive LP Deposit & Minting Simulator */}\n      <div className=\"border border-[#0A0A0A] bg-white p-6 md:p-8 space-y-6\">\n        <div className=\"border-b border-[#E4E4E7] pb-4\">\n          <div className=\"text-xs font-mono uppercase text-[#71717A] tracking-wider\">\n            LIQUIDITY PROVISION // SPL TOKEN-2022 SIMULATOR\n          </div>\n          <h3 className=\"text-xl font-bold text-[#0A0A0A] font-mono mt-1\">\n            Deposit eINR &amp; Receive Transferable SPL LP Tokens\n          </h3>\n        </div>\n\n        <form onSubmit={handleSimulateDeposit} className=\"grid grid-cols-1 lg:grid-cols-12 gap-8 items-start\">\n          <div className=\"lg:col-span-5 space-y-4 font-mono text-xs\">\n            <div>\n              <label className=\"block text-[10px] text-[#71717A] uppercase mb-1 font-semibold\">\n                Select Tranche Vault\n              </label>\n              <div className=\"grid grid-cols-2 gap-2\">\n                <button\n                  type=\"button\"\n                  onClick={() => setSelectedPoolId(\"senior-pool-01\")}\n                  className={`p-3 border text-left transition-all ${\n                    selectedPoolId === \"senior-pool-01\"\n                      ? \"border-[#0A0A0A] bg-[#0A0A0A] text-white\"\n                      : \"border-[#E4E4E7] bg-white text-[#0A0A0A]\"\n                  }`}\n                >\n                  <div className=\"font-bold\">Senior (11.5%)</div>\n                  <div className=\"text-[10px] opacity-80\">Protected Pool</div>\n                </button>\n                <button\n                  type=\"button\"\n                  onClick={() => setSelectedPoolId(\"junior-pool-01\")}\n                  className={`p-3 border text-left transition-all ${\n                    selectedPoolId === \"junior-pool-01\"\n                      ? \"border-[#0A0A0A] bg-[#0A0A0A] text-white\"\n                      : \"border-[#E4E4E7] bg-white text-[#0A0A0A]\"\n                  }`}\n                >\n                  <div className=\"font-bold\">Junior (24.0%)</div>\n                  <div className=\"text-[10px] opacity-80\">First-Loss Pool</div>\n                </button>\n              </div>\n            </div>\n\n            <div>\n              <label className=\"block text-[10px] text-[#71717A] uppercase mb-1 font-semibold\">\n                Deposit Amount (eINR)\n              </label>\n              <input\n                type=\"number\"\n                value={depositAmount}\n                onChange={(e) => setDepositAmount(e.target.value)}\n                className=\"w-full border border-[#0A0A0A] px-3 py-2 text-sm font-bold bg-white text-[#0A0A0A]\"\n                placeholder=\"500000\"\n              />\n              <div className=\"flex gap-2 mt-1\">\n                {[100000, 500000, 2500000, 10000000].map((val) => (\n                  <button\n                    type=\"button\"\n                    key={val}\n                    onClick={() => setDepositAmount(val.toString())}\n                    className=\"px-2 py-0.5 bg-[#F4F4F5] text-[10px] text-[#71717A] hover:text-[#0A0A0A]\"\n                  >\n                    \342\202\271{(val / 100000).toFixed(0)}L\n                  </button>\n                ))}\n              </div>\n            </div>\n\n            <button\n              type=\"submit\"\n              className=\"w-full py-3 bg-[#059669] text-white hover:bg-[#047857] transition-colors font-bold uppercase tracking-wider text-xs flex items-center justify-center gap-2\"\n            >\n              <Coins className=\"w-4 h-4\" /> DEPOSIT eINR &amp; MINT LP TOKENS\n            </button>\n          </div>\n\n          <div className=\"lg:col-span-7 bg-[#F4F4F5] border border-[#E4E4E7] p-6 space-y-4 font-mono\">\n            <div className=\"text-[10px] uppercase text-[#71717A] font-bold border-b border-[#E4E4E7] pb-2\">\n              DEPOSIT RECEIPT // PROJECTED YIELD &amp; LP ALLOCATION\n            </div>\n\n            <div className=\"grid grid-cols-2 md:grid-cols-3 gap-4\">\n              <div>\n                <div className=\"text-[10px] text-[#71717A] uppercase\">ESTIMATED LP MINTED</div>\n                <div className=\"text-xl font-extrabold text-[#0A0A0A]\">{estimatedLpTokens}</div>\n                <div className=\"text-[10px] text-[#52525B]\">Transferable SPL Token</div>\n              </div>\n\n              <div>\n                <div className=\"text-[10px] text-[#71717A] uppercase\">ESTIMATED ANNUAL RETURN</div>\n                <div className=\"text-xl font-extrabold text-[#059669]\">\n                  + \342\202\271{Number(estimatedAnnualYield).toLocaleString(\"en-IN\")}\n                </div>\n                <div className=\"text-[10px] text-[#52525B]\">{activePool.targetApy}% APY</div>\n              </div>\n\n              <div>\n                <div className=\"text-[10px] text-[#71717A] uppercase\">DEFAULT BUFFER</div>\n                <div className=\"text-xl font-extrabold text-[#2563EB]\">\n                  {activePool.type === \"Senior\" ? \"100% Protected\" : \"20% First-Loss\"}\n                </div>\n                <div className=\"text-[10px] text-[#52525B]\">Via Junior &amp; Reserve</div>\n              </div>\n            </div>\n\n            {depositSuccessMsg && (\n              <div className=\"p-3 bg-[#ECFDF5] border border-[#A7F3D0] text-[#059669] text-xs font-sans flex items-center gap-2\">\n                <CheckCircle2 className=\"w-4 h-4 shrink-0\" />\n                <span>{depositSuccessMsg}</span>\n              </div>\n            )}\n\n            <div className=\"text-xs text-[#52525B] font-sans border-t border-[#E4E4E7] pt-3 leading-relaxed\">\n              <strong>Secondary Liquidity Note:</strong> SPL LP tokens can be traded on Solana AMMs or used as collateral across Solana DeFi before the underlying 90-day invoices mature.\n            </div>\n          </div>\n        </form>\n      </div>\n\n      {/* Auto-Diversification Sector Vaults */}\n      <div className=\"border border-[#E4E4E7] bg-white p-6 space-y-4 font-mono text-xs\">\n        <div className=\"border-b border-[#E4E4E7] pb-3 flex items-center justify-between\">\n          <div>\n            <div className=\"text-[10px] text-[#71717A] uppercase\">AUTO-DIVERSIFICATION VAULTS</div>\n            <div className=\"text-sm font-bold text-[#0A0A0A]\">\n              Geographic &amp; Industrial Cluster Tagged Liquidity Routing\n            </div>\n          </div>\n          <span className=\"text-[10px] bg-[#F4F4F5] px-2 py-1 text-[#71717A]\">\n            ALGORITHM: CONCENTRATION CAP 15% PER BUYER\n          </span>\n        </div>\n\n        <div className=\"grid grid-cols-1 md:grid-cols-3 gap-4\">\n          <div className=\"border border-[#E4E4E7] p-4 space-y-2 bg-[#FAFAFA]\">\n            <div className=\"flex justify-between items-center\">\n              <span className=\"font-bold text-[#0A0A0A]\">Auto Ancillaries Cluster</span>\n              <span className=\"text-[10px] text-[#2563EB] font-bold\">Pune / Pimpri</span>\n            </div>\n            <p className=\"text-[11px] text-[#52525B] font-sans\">\n              Forged pinions, chassis stampings, electrical harnesses supplied to Tata Motors, Mahindra, Bajaj Auto.\n            </p>\n            <div className=\"text-[10px] text-[#71717A] pt-2 border-t border-[#E4E4E7]\">\n              ALLOCATION: \342\202\27114.5 Cr | HISTORICAL LOSS: 0.00%\n            </div>\n          </div>\n\n          <div className=\"border border-[#E4E4E7] p-4 space-y-2 bg-[#FAFAFA]\">\n            <div className=\"flex justify-between items-center\">\n              <span className=\"font-bold text-[#0A0A0A]\">Textiles &amp; Synthetics</span>\n              <span className=\"text-[10px] text-[#2563EB] font-bold\">Surat / Ahmedabad</span>\n            </div>\n            <p className=\"text-[11px] text-[#52525B] font-sans\">\n              Polyester rolls, weaving looms, apparel supplies to Reliance Retail, Arvind, Raymond.\n            </p>\n            <div className=\"text-[10px] text-[#71717A] pt-2 border-t border-[#E4E4E7]\">\n              ALLOCATION: \342\202\27112.8 Cr | HISTORICAL LOSS: 0.12%\n            </div>\n          </div>\n\n          <div className=\"border border-[#E4E4E7] p-4 space-y-2 bg-[#FAFAFA]\">\n            <div className=\"flex justify-between items-center\">\n              <span className=\"font-bold text-[#0A0A0A]\">Electronics &amp; EMS</span>\n              <span className=\"text-[10px] text-[#2563EB] font-bold\">Noida / Sriperumbudur</span>\n            </div>\n            <p className=\"text-[11px] text-[#52525B] font-sans\">\n              PCB assemblies, copper cabling, injection molded cases for Dixon Tech, Foxconn, Havells.\n            </p>\n            <div className=\"text-[10px] text-[#71717A] pt-2 border-t border-[#E4E4E7]\">\n              ALLOCATION: \342\202\27111.15 Cr | HISTORICAL LOSS: 0.00%\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    }
