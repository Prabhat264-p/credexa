        }
        lines {
          text: "                  <li><strong>GST Compliance:</strong> GSTIN structure verification (2 digits state code + 10 digits PAN + 1 entity + 1 \'Z\' + 1 check digit) and GSTR-3B tax payment checks.</li>"
