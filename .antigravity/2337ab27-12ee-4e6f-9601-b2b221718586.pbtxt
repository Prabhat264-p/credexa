    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \"react\";\nimport { X, Plus, ShieldAlert, CheckCircle2, FileText } from \"lucide-react\";\nimport { InvoiceRecord, FactoringMode } from \"../types\";\n\ninterface TokenizeModalProps {\n  isOpen: boolean;\n  onClose: () => void;\n  onSubmit: (invoice: Partial<InvoiceRecord>) => void;\n}\n\nexport const TokenizeModal: React.FC<TokenizeModalProps> = ({\n  isOpen,\n  onClose,\n  onSubmit,\n}) => {\n  const [sellerName, setSellerName] = useState(\"Mahindra Precision Stampings Pvt Ltd\");\n  const [sellerGstin, setSellerGstin] = useState(\"27AAACM4819P1Z3\");\n  const [sellerLocation, setSellerLocation] = useState(\"Bhosari MIDC, Pune, MH\");\n  const [buyerName, setBuyerName] = useState(\"Tata Motors Commercial Vehicles Ltd\");\n  const [buyerGstin, setBuyerGstin] = useState(\"27AAACT2727Q1ZW\");\n  const [invoiceNumber, setInvoiceNumber] = useState(\"MPS/PUN/2026/0441\");\n  const [faceValueInr, setFaceValueInr] = useState(\"3500000\");\n  const [tenureDays, setTenureDays] = useState(\"90\");\n  const [hsnCode, setHsnCode] = useState(\"87082900\");\n  const [itemDescription, setItemDescription] = useState(\"Cold-rolled sheet metal side panels and cabin floor assemblies\");\n  const [ewayBillNumber, setEwayBillNumber] = useState(\"291847102948\");\n  const [poNumber, setPoNumber] = useState(\"TM/PUN/CV/PO-99104\");\n  const [factoringMode, setFactoringMode] = useState<FactoringMode>(\"Recourse\");\n\n  if (!isOpen) return null;\n\n  const handleSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    const faceVal = Number(faceValueInr) || 1000000;\n    const tenure = Number(tenureDays) || 90;\n    const advanceRate = factoringMode === \"Recourse\" ? 85 : 80;\n    const fundedAmt = (faceVal * advanceRate) / 100;\n    const discountRate = factoringMode === \"Recourse\" ? 850 : 1050;\n\n    const randomSuffix = Math.floor(1000 + Math.random() * 9000);\n    const newRecord: Partial<InvoiceRecord> = {\n      id: `INV-2026-MH-${randomSuffix}`,\n      token2022Mint: `CRDxMint${randomSuffix}mQ4aBC${randomSuffix.toString().slice(0, 2)}...SPL22`,\n      invoiceNumber,\n      invoiceDate: new Date().toISOString().split(\"T\")[0],\n      tenureDays: tenure,\n      faceValueInr: faceVal,\n      advanceRatePct: advanceRate,\n      fundedAmountInr: fundedAmt,\n      sellerName,\n      sellerGstin,\n      sellerLocation,\n      sellerWallet: \"7eT4...\" + randomSuffix,\n      buyerName,\n      buyerGstin,\n      buyerWallet: \"TaTa...99CV\",\n      itemDescription,\n      hsnCode,\n      ewayBillNumber,\n      poNumber,\n      irn: \"9f8a\" + Math.random().toString(16).slice(2, 10) + \"7c2b5d4e1a0b3c6d8e7f9a0b1c2d3e4f\",\n      factoringMode,\n      status: \"Draft\",\n      discountRateBps: discountRate,\n      seniorFundingInr: 0,\n      juniorFundingInr: 0,\n      buyerAttested: false,\n      buyerRebateBps: 0,\n      maturityDate: new Date(Date.now() + tenure * 86400000).toISOString().split(\"T\")[0],\n      daysOverdue: 0,\n      authenticityScore: 0,\n      riskTier: \"TIER_A\",\n      collateralLockedInr: factoringMode === \"Recourse\" ? faceVal * 0.1 : 0,\n    };\n\n    onSubmit(newRecord);\n    onClose();\n  };\n\n  return (\n    <div className=\"fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-xs p-4 overflow-y-auto\">\n      <div className=\"border-2 border-[#0A0A0A] bg-white w-full max-w-3xl my-8 font-mono text-xs shadow-2xl\">\n        {/* Modal Header */}\n        <div className=\"border-b border-[#0A0A0A] bg-[#0A0A0A] text-white px-6 py-4 flex items-center justify-between\">\n          <div className=\"flex items-center gap-3\">\n            <FileText className=\"w-4 h-4 text-[#059669]\" />\n            <span className=\"font-bold text-sm tracking-wide\">\n              TOKENIZE INVOICE // SPL TOKEN-2022 MINT\n            </span>\n          </div>\n          <button\n            onClick={onClose}\n            className=\"text-[#A1A1AA] hover:text-white transition-colors\"\n          >\n            <X className=\"w-5 h-5\" />\n          </button>\n        </div>\n\n        {/* Modal Body */}\n        <form onSubmit={handleSubmit} className=\"p-6 space-y-6\">\n          <div className=\"border border-[#E4E4E7] bg-[#F8F9FA] p-4 text-[11px] text-[#52525B] leading-relaxed\">\n            <span className=\"font-bold text-[#0A0A0A]\">Legal Token-2022 Assignment:</span> Minting this token embeds an irrevocable debt assignment clause under the Indian Factoring Regulation Act, 2011. The receivable is assigned to Credexa Liquidity Vaults until full eINR settlement.\n          </div>\n\n          <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n            {/* Seller Details */}\n            <div className=\"space-y-3\">\n              <div className=\"text-[10px] text-[#71717A] uppercase font-bold border-b border-[#E4E4E7] pb-1\">\n                MSME SUPPLIER INFORMATION\n              </div>\n              <div>\n                <label className=\"block text-[10px] text-[#71717A] mb-1 uppercase\">Seller Legal Entity</label>\n                <input\n                  type=\"text\"\n                  required\n                  value={sellerName}\n                  onChange={(e) => setSellerName(e.target.value)}\n                  className=\"w-full border border-[#0A0A0A] px-3 py-2 text-xs bg-white text-[#0A0A0A]\"\n                />\n              </div>\n              <div>\n                <label className=\"block text-[10px] text-[#71717A] mb-1 uppercase\">Supplier GSTIN (15 Digits)</label>\n                <input\n                  type=\"text\"\n                  required\n                  maxLength={15}\n                  value={sellerGstin}\n                  onChange={(e) => setSellerGstin(e.target.value)}\n                  className=\"w-full border border-[#0A0A0A] px-3 py-2 text-xs bg-white uppercase font-mono\"\n                />\n              </div>\n              <div>\n                <label className=\"block text-[10px] text-[#71717A] mb-1 uppercase\">Cluster / Location</label>\n                <input\n                  type=\"text\"\n                  required\n                  value={sellerLocation}\n                  onChange={(e) => setSellerLocation(e.target.value)}\n                  className=\"w-full border border-[#0A0A0A] px-3 py-2 text-xs bg-white\"\n                />\n              </div>\n            </div>\n\n            {/* Buyer Details */}\n            <div className=\"space-y-3\">\n              <div className=\"text-[10px] text-[#71717A] uppercase font-bold border-b border-[#E4E4E7] pb-1\">\n                ENTERPRISE BUYER INFORMATION\n              </div>\n              <div>\n                <label className=\"block text-[10px] text-[#71717A] mb-1 uppercase\">Buyer Corporate Name</label>\n                <input\n                  type=\"text\"\n                  required\n                  value={buyerName}\n                  onChange={(e) => setBuyerName(e.target.value)}\n                  className=\"w-full border border-[#0A0A0A] px-3 py-2 text-xs bg-white text-[#0A0A0A]\"\n                />\n              </div>\n              <div>\n                <label className=\"block text-[10px] text-[#71717A] mb-1 uppercase\">Buyer GSTIN (15 Digits)</label>\n                <input\n                  type=\"text\"\n                  required\n                  maxLength={15}\n                  value={buyerGstin}\n                  onChange={(e) => setBuyerGstin(e.target.value)}\n                  className=\"w-full border border-[#0A0A0A] px-3 py-2 text-xs bg-white uppercase font-mono\"\n                />\n              </div>\n              <div>\n                <label className=\"block text-[10px] text-[#71717A] mb-1 uppercase\">Purchase Order (PO) Number</label>\n                <input\n                  type=\"text\"\n                  required\n                  value={poNumber}\n                  onChange={(e) => setPoNumber(e.target.value)}\n                  className=\"w-full border border-[#0A0A0A] px-3 py-2 text-xs bg-white font-mono\"\n                />\n              </div>\n            </div>\n          </div>\n\n          {/* Invoice Terms */}\n          <div className=\"space-y-3 pt-2\">\n            <div className=\"text-[10px] text-[#71717A] uppercase font-bold border-b border-[#E4E4E7] pb-1\">\n              INVOICE FINANCIALS &amp; AUDIT TRAILS\n            </div>\n\n            <div className=\"grid grid-cols-1 md:grid-cols-4 gap-4\">\n              <div>\n                <label className=\"block text-[10px] text-[#71717A] mb-1 uppercase\">Face Value (\342\202\271 eINR)</label>\n                <input\n                  type=\"number\"\n                  required\n                  value={faceValueInr}\n                  onChange={(e) => setFaceValueInr(e.target.value)}\n                  className=\"w-full border border-[#0A0A0A] px-3 py-2 text-xs font-bold text-[#059669] bg-white font-mono\"\n                />\n              </div>\n\n              <div>\n                <label className=\"block text-[10px] text-[#71717A] mb-1 uppercase\">Tenure (Days)</label>\n                <select\n                  value={tenureDays}\n                  onChange={(e) => setTenureDays(e.target.value)}\n                  className=\"w-full border border-[#0A0A0A] px-3 py-2 text-xs bg-white\"\n                >\n                  <option value=\"30\">30 Days</option>\n                  <option value=\"60\">60 Days</option>\n                  <option value=\"90\">90 Days (Standard)</option>\n                  <option value=\"120\">120 Days (Severe)</option>\n                </select>\n              </div>\n\n              <div>\n                <label className=\"block text-[10px] text-[#71717A] mb-1 uppercase\">HSN Code (8 Digits)</label>\n                <input\n                  type=\"text\"\n                  required\n                  maxLength={8}\n                  value={hsnCode}\n                  onChange={(e) => setHsnCode(e.target.value)}\n                  className=\"w-full border border-[#0A0A0A] px-3 py-2 text-xs bg-white font-mono\"\n                />\n              </div>\n\n              <div>\n                <label className=\"block text-[10px] text-[#71717A] mb-1 uppercase\">e-Way Bill Number</label>\n                <input\n                  type=\"text\"\n                  required\n                  maxLength={12}\n                  value={ewayBillNumber}\n                  onChange={(e) => setEwayBillNumber(e.target.value)}\n                  className=\"w-full border border-[#0A0A0A] px-3 py-2 text-xs bg-white font-mono\"\n                />\n              </div>\n            </div>\n\n            <div>\n              <label className=\"block text-[10px] text-[#71717A] mb-1 uppercase\">Item Line Description</label>\n              <input\n                type=\"text\"\n                required\n                value={itemDescription}\n                onChange={(e) => setItemDescription(e.target.value)}\n                className=\"w-full border border-[#0A0A0A] px-3 py-2 text-xs bg-white\"\n              />\n            </div>\n          </div>\n\n          {/* Factoring Mode Selection */}\n          <div className=\"space-y-2 pt-2\">\n            <div className=\"text-[10px] text-[#71717A] uppercase font-bold border-b border-[#E4E4E7] pb-1\">\n              FACTORING MODE &amp; RECOURSE GUARANTEE\n            </div>\n\n            <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n              <label\n                className={`border p-3 cursor-pointer transition-all ${\n                  factoringMode === \"Recourse\"\n                    ? \"border-[#0A0A0A] bg-[#0A0A0A] text-white\"\n                    : \"border-[#E4E4E7] bg-white text-[#0A0A0A]\"\n                }`}\n              >\n                <div className=\"flex items-center gap-2 mb-1\">\n                  <input\n                    type=\"radio\"\n                    name=\"factoring\"\n                    checked={factoringMode === \"Recourse\"}\n                    onChange={() => setFactoringMode(\"Recourse\")}\n                    className=\"accent-white\"\n                  />\n                  <span className=\"font-bold\">Recourse Factoring</span>\n                </div>\n                <p className=\"text-[10px] leading-relaxed opacity-80\">\n                  MSME stakes 10% collateral. Lower discount rate (8.5% APR). If buyer defaults past 15-day grace period, collateral is automatically liquidated.\n                </p>\n              </label>\n\n              <label\n                className={`border p-3 cursor-pointer transition-all ${\n                  factoringMode === \"NonRecourse\"\n                    ? \"border-[#0A0A0A] bg-[#0A0A0A] text-white\"\n                    : \"border-[#E4E4E7] bg-white text-[#0A0A0A]\"\n                }`}\n              >\n                <div className=\"flex items-center gap-2 mb-1\">\n                  <input\n                    type=\"radio\"\n                    name=\"factoring\"\n                    checked={factoringMode === \"NonRecourse\"}\n                    onChange={() => setFactoringMode(\"NonRecourse\")}\n                    className=\"accent-white\"\n                  />\n                  <span className=\"font-bold\">Non-Recourse Factoring</span>\n                </div>\n                <p className=\"text-[10px] leading-relaxed opacity-80\">\n                  Zero collateral locked for MSME. Default risk is 100% absorbed by Credexa Junior First-Loss tranche and Insurance Reserve. Higher risk premium (10.5% APR).\n                </p>\n              </label>\n            </div>\n          </div>\n\n          {/* Action Buttons */}\n          <div className=\"border-t border-[#E4E4E7] pt-4 flex items-center justify-end gap-3\">\n            <button\n              type=\"button\"\n              onClick={onClose}\n              className=\"px-5 py-2.5 border border-[#0A0A0A] text-[#0A0A0A] hover:bg-[#F4F4F5] transition-colors uppercase font-bold\"\n            >\n              Cancel\n            </button>\n            <button\n              type=\"submit\"\n              className=\"px-6 py-2.5 bg-[#059669] text-white hover:bg-[#047857] transition-colors uppercase font-bold flex items-center gap-2\"\n            >\n              <Plus className=\"w-4 h-4\" /> MINT TOKEN-2022 INVOICE\n            </button>\n          </div>\n        </form>\n      </div>\n    </div>\n  );\n};\n"
    }
